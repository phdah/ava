{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phdah/ava/blob/main/distribution/schemas/upgrade.schema.json",
  "title": "Ava upgrade transaction journal",
  "description": "Schema for the Ava-managed /.ava/state/upgrade.json durable upgrade transaction journal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "upgrade_schema",
    "transaction_id",
    "status",
    "stage",
    "source",
    "target",
    "path",
    "current_edge",
    "created_at",
    "updated_at",
    "staging",
    "migrations",
    "managed_changes",
    "project_changes",
    "failure",
    "allowed_operations"
  ],
  "properties": {
    "upgrade_schema": {"const": 1},
    "transaction_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "status": {"enum": ["idle", "active", "blocked", "complete", "aborted", "rolled-back"]},
    "stage": {"enum": ["idle", "planning", "preflight", "staged", "migrating", "validating", "base-installed", "semantic", "rollback", "complete", "aborted", "rolled-back"]},
    "source": {"anyOf": [{"$ref": "#/$defs/releaseState"}, {"type": "null"}]},
    "target": {"anyOf": [{"$ref": "#/$defs/releaseState"}, {"type": "null"}]},
    "path": {"type": "array", "items": {"$ref": "#/$defs/pathEdge"}},
    "current_edge": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "created_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "updated_at": {"type": "string", "format": "date-time"},
    "staging": {"anyOf": [{"$ref": "#/$defs/stagingState"}, {"type": "null"}]},
    "migrations": {"$ref": "#/$defs/migrationJournal"},
    "managed_changes": {"type": "array", "items": {"$ref": "#/$defs/managedChange"}},
    "project_changes": {"type": "array", "items": {"$ref": "#/$defs/projectChange"}},
    "failure": {"anyOf": [{"$ref": "#/$defs/failure"}, {"type": "null"}]},
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["inspect", "resolve", "resume", "abort", "rollback", "reconcile-semantic", "normal"]}
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(alpha|beta|rc)\\.[1-9][0-9]*)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "releaseState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ava_version", "okf_version", "tag", "source_revision", "release_manifest_sha256"],
      "properties": {
        "ava_version": {"$ref": "#/$defs/version"},
        "okf_version": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(alpha|beta|rc)\\.[1-9][0-9]*)?$"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pathEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "mode", "intermediates", "carry_unresolved_semantic_state", "migration_ids", "guidance_paths", "completed"],
      "properties": {
        "from": {"$ref": "#/$defs/version"},
        "to": {"$ref": "#/$defs/version"},
        "mode": {"enum": ["direct", "chained"]},
        "intermediates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/version"}},
        "carry_unresolved_semantic_state": {"type": "boolean"},
        "migration_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}},
        "guidance_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
        "completed": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "direct"}}, "required": ["mode"]}, "then": {"properties": {"intermediates": {"maxItems": 0}}}},
        {"if": {"properties": {"mode": {"const": "chained"}}, "required": ["mode"]}, "then": {"properties": {"intermediates": {"minItems": 1}}}}
      ]
    },
    "stagingState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "backup", "candidate_manifest", "live_mutation_started", "managed_commit_complete"],
      "properties": {
        "workspace": {"type": "string", "minLength": 1},
        "backup": {"type": "string", "minLength": 1},
        "candidate_manifest": {"type": "string", "minLength": 1},
        "live_mutation_started": {"type": "boolean"},
        "managed_commit_complete": {"type": "boolean"}
      }
    },
    "migrationJournal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_order", "active_id", "completed"],
      "properties": {
        "resolved_order": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}},
        "active_id": {"anyOf": [{"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, {"type": "null"}]},
        "completed": {"type": "array", "items": {"$ref": "#/$defs/completedMigration"}}
      }
    },
    "completedMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "descriptor_sha256", "edge_index", "completed_at", "postcondition_verified"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "edge_index": {"type": "integer", "minimum": 0},
        "completed_at": {"type": "string", "format": "date-time"},
        "postcondition_verified": {"const": true}
      }
    },
    "managedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "previous_sha256", "current_sha256", "target_sha256", "classification"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "operation": {"enum": ["retain", "create", "replace", "delete"]},
        "previous_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "current_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "target_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "classification": {"enum": ["unchanged", "conflict", "staged", "applied", "rolled-back"]}
      }
    },
    "projectChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "change_type", "recorded_at", "resolution"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "change_type": {"enum": ["created", "modified", "deleted", "moved"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "resolution": {"enum": ["unresolved", "retained", "reverted", "reconciled"]}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "stage", "recoverable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message": {"type": "string", "minLength": 1},
        "stage": {"enum": ["planning", "preflight", "staged", "migrating", "validating", "base-installed", "semantic", "rollback"]},
        "recoverable": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "idle"}}, "required": ["status"]},
      "then": {"properties": {
        "transaction_id": {"type": "null"},
        "stage": {"const": "idle"},
        "source": {"type": "null"},
        "target": {"type": "null"},
        "path": {"maxItems": 0},
        "current_edge": {"type": "null"},
        "created_at": {"type": "null"},
        "staging": {"type": "null"},
        "failure": {"type": "null"},
        "allowed_operations": {"const": ["normal"]}
      }}
    },
    {
      "if": {"properties": {"status": {"enum": ["active", "blocked"]}}, "required": ["status"]},
      "then": {"properties": {
        "transaction_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/releaseState"},
        "target": {"$ref": "#/$defs/releaseState"},
        "path": {"minItems": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "allowed_operations": {"not": {"contains": {"const": "normal"}}}
      }}
    },
    {"if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]}, "then": {"properties": {"failure": {"$ref": "#/$defs/failure"}}}},
    {"if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]}, "then": {"properties": {"stage": {"const": "complete"}, "failure": {"type": "null"}, "allowed_operations": {"const": ["normal"]}}}},
    {"if": {"properties": {"status": {"const": "aborted"}}, "required": ["status"]}, "then": {"properties": {"stage": {"const": "aborted"}, "allowed_operations": {"const": ["normal"]}}}},
    {"if": {"properties": {"status": {"const": "rolled-back"}}, "required": ["status"]}, "then": {"properties": {"stage": {"const": "rolled-back"}, "allowed_operations": {"const": ["normal"]}}}}
  ]
}
