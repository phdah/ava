{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "8e41b99b90000ce684aac589cb1ef25217598956",
  "release-type": "simple",
  "initial-version": "1.0.0-alpha.1",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "draft": true,
  "prerelease": true,
  "force-tag-creation": true,
  "versioning": "prerelease",
  "prerelease-type": "alpha",
  "separate-pull-requests": false,
  "always-update": true,
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "group-pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "pull-request-header": "This pull request prepares an Ava release. Review the exact version and changelog before merging.",
  "pull-request-footer": "Merge this Release Please PR with a merge commit. Do not squash or rebase it: accepted qualification is bound to the release-PR commit ancestry. Merging authorizes publication of the resulting tagged revision. The workflow publishes only after qualification, reproducible assembly, attestation, and asset upload succeed.",
  "changelog-sections": [
    {"type": "feat", "section": "Features"},
    {"type": "fix", "section": "Bug Fixes"},
    {"type": "perf", "section": "Performance"},
    {"type": "revert", "section": "Reverts"},
    {"type": "docs", "section": "Documentation", "hidden": true},
    {"type": "refactor", "section": "Code Refactoring", "hidden": true},
    {"type": "test", "section": "Tests", "hidden": true},
    {"type": "build", "section": "Build", "hidden": true},
    {"type": "ci", "section": "Continuous Integration", "hidden": true},
    {"type": "style", "section": "Styles", "hidden": true},
    {"type": "chore", "section": "Miscellaneous Chores", "hidden": true}
  ],
  "packages": {
    ".": {
      "version-file": "version.txt",
      "release-as": "1.0.0-alpha.19",
      "changelog-sections": [
        {"type": "feat", "section": "Features"},
        {"type": "fix", "section": "Bug Fixes"},
        {"type": "perf", "section": "Performance"},
        {"type": "revert", "section": "Reverts"},
        {"type": "docs", "section": "Documentation", "hidden": true},
        {"type": "refactor", "section": "Code Refactoring", "hidden": true},
        {"type": "test", "section": "Tests", "hidden": true},
        {"type": "build", "section": "Build", "hidden": true},
        {"type": "ci", "section": "Continuous Integration", "hidden": true},
        {"type": "style", "section": "Styles", "hidden": true},
        {"type": "chore", "section": "Release Operations"}
      ]
    }
  }
}
